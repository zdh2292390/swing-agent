# ---- 标的池与周期 ----
# 可混写组名和单个标的。组：@mag7 @semis @berkshire @storage @ai_infra @space @benchmarks（见 tradebot/universe.py）
# 统一用交易所写法（BRK.B），系统自动转成 yfinance 的 BRK-B；带交易所后缀的海外标的（005930.KS）只监控不交易
SYMBOLS=@mag7,@semis,@berkshire,@storage,@ai_infra,@space
VIEW_GROUPS=mag7,storage             # 面板“信号”“末日期权”页默认勾选的板块，其他板块手动勾；留空 = 全部
INTERVAL=1d                          # 1d 日线（swing）或 1h 小时线
LOOKBACK_DAYS=                       # 实盘算信号拉多少天，留空按周期默认：1d=750，1h=60
BACKTEST_DAYS=                       # 回测默认回溯，留空：1d=5000，1h=729（yfinance 小时线上限）
STRATEGY=trend_pullback              # trend_pullback | breakout | post_earnings | ma_cross | buy_and_hold
STRATEGY_PARAMS=max_positions=5,atr_stop_mult=2.5   # 各策略参数见 README“策略”一节

# ---- 执行模式 ----
MODE=local                           # local = 本地模拟撮合，无需任何 key；alpaca = Alpaca 模拟盘/实盘
ENTRY_MODE=fresh                     # fresh = 空仓起步只跟“新入场”信号，不追策略几周前的老仓位；align = 直接对齐策略当前仓位（中途上车）
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true                    # true 用模拟盘 endpoint；false 才是实盘，慎改
INITIAL_CASH=100000

# ---- 风控 ----
MAX_POSITION_PCT=0.20                # 单标的最大仓位占净值比例
MAX_GROSS_EXPOSURE=1.00              # 总仓位上限
DAILY_LOSS_LIMIT_PCT=0.02            # 当日亏损超过 2% 清仓并停止开仓
MAX_DRAWDOWN_PCT=0.10                # 从净值高点回撤超过 10% 停机
MIN_TRADE_VALUE=200                  # 低于此金额的调仓忽略，避免碎单

# ---- 回测成本 ----
COMMISSION_BPS=0
SLIPPAGE_BPS=2

# ---- Claude 决策层（可选）----
AGENT_ENABLED=false
AGENT_MODEL=claude-opus-5
# ANTHROPIC_API_KEY=                 # 或者用 `ant auth login`，二选一
